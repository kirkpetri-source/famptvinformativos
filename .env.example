# =============================================================================
# FAMP TV Informativos — variaveis de ambiente
# Copie para .env.local e preencha. NUNCA versione o .env.local.
# =============================================================================

# --- Firebase: cliente (publico, vai no bundle) ------------------------------
VITE_FIREBASE_API_KEY=
# Em producao, prefira o proprio dominio do app (o vercel.json faz o proxy de
# /__/auth para o firebaseapp.com). O login por redirect no celular depende de o
# handler ser da mesma origem: Safari e Firefox bloqueiam o armazenamento de
# terceiros em *.firebaseapp.com e o retorno se perde em silencio.
# Antes de trocar, cadastre https://SEU-DOMINIO/__/auth/handler em
# Google Cloud Console > APIs e servicos > Credenciais > cliente OAuth 2.0 >
# URIs de redirecionamento autorizados. Sem isso da redirect_uri_mismatch.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Projetos criados recentemente usam *.firebasestorage.app, nao *.appspot.com.
# Confira o valor exato no console do Firebase.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Aponta o app para os emuladores locais. Use "true" apenas em desenvolvimento.
VITE_USAR_EMULADORES=false

# --- Firebase Admin: servidor (NUNCA expor no cliente) -----------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Cole a chave entre aspas, com os \n literais preservados.
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# --- Resend (e-mail transacional) --------------------------------------------
RESEND_API_KEY=
# Precisa de dominio verificado no Resend para entregar a terceiros.
RESEND_FROM=TV Informativos FAMP <informativos@seudominio.com.br>
# Aceita lista separada por virgula.
ADMIN_EMAIL=

# --- Seguranca do cron --------------------------------------------------------
# Gere com: openssl rand -base64 32
CRON_SECRET=

# --- Bootstrap do primeiro administrador (usado so pelo scripts/seed-admin.js)
BOOTSTRAP_ADMIN_EMAIL=

# --- URL publica, usada nos links dos e-mails ---------------------------------
APP_URL=http://localhost:5173
