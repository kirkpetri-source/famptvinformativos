{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/atualizar-status",
      "schedule": "0 6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:caminho*",
      "destination": "https://famp-tv-informativos.firebaseapp.com/__/auth/:caminho*"
    },
    {
      "source": "/__/firebase/:caminho*",
      "destination": "https://famp-tv-informativos.firebaseapp.com/__/firebase/:caminho*"
    },
    {
      "source": "/((?!api/|__/).*)",
      "destination": "/index.html"
    }
  ]
}
