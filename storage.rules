rules_version = '2';

// =============================================================================
// FAMP TV Informativos — regras do Storage
//
// POR QUE O UID ESTA NO CAMINHO
//
// A versao anterior perguntava ao Firestore de quem era a pasta:
//   firestore.get(/databases/(default)/documents/informativos/$(docId))
// Regras cruzadas Storage -> Firestore exigem uma permissao IAM no agente de
// servico do Cloud Storage que nao vem habilitada por padrao, e o upload
// falhava com 403 sem dizer o motivo.
//
// Com o uid no caminho, a mesma garantia sai de graca e sem dependencia
// externa: so escreve na sua pasta quem e dono dela.
//
// Para o admin ler a midia dos outros, o perfil vai no token como custom
// claim (`admin`), sincronizado pelo Admin SDK a cada mudanca de acesso.
// =============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function dominioPermitido() {
      return request.auth != null
        && request.auth.token.email != null
        && (request.auth.token.email.lower().matches('.*@fampfaculdade[.]com[.]br')
            || request.auth.token.email.lower() == 'kirkpetri@gmail.com'
            // ===== CONTA DE TESTE — REMOVER ANTES DE ENTREGAR A FAMP =====
            || request.auth.token.email.lower() == 'liontech.sup@gmail.com');
    }

    function isAdmin() {
      return request.auth.token.admin == true;
    }

    match /informativos/{uid}/{ano}/{mes}/{docId}/{arquivo} {

      allow read: if dominioPermitido()
        && (request.auth.uid == uid || isAdmin());

      // Teto absoluto de 80 MB: a regra nao le configuracao, entao os limites
      // por tipo (imagem 15, video 70, PDF 20) sao aplicados na aplicacao,
      // antes do upload.
      allow create: if dominioPermitido()
        && request.auth.uid == uid
        && request.resource.size <= 80 * 1024 * 1024
        && request.resource.contentType.matches('(image/(jpeg|png)|video/mp4|application/pdf)');

      // Sem sobrescrita e sem exclusao pelo cliente.
      // O expurgo e feito pelo Admin SDK no cron, que ignora estas regras.
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
